# Local OpenCode solver. Sign in to your existing OpenCode Go profile first.
# npm run dev:opencode starts or reuses the server and starts Chalk.
CHALK_SOLVER=opencode
OPENCODE_SERVER_URL=http://127.0.0.1:4098
OPENCODE_PROVIDER_ID=opencode-go
OPENCODE_MODEL=deepseek-v4-flash
OPENCODE_VISION_MODEL=kimi-k2.6

# Optional Google backend: set CHALK_SOLVER=gemini to select it.
# Server only Google Gemini API key. It is read inside the API routes and is
# never sent to the browser. Leave it empty in the repository and set the real
# value in the Vercel project environment variables, then redeploy, or in
# .env.local for local development, then restart the dev server.
GEMINI_API_KEY=

# The model both calls use unless a call names its own.
GEMINI_MODEL=gemini-3.8-flash

# Optional per call overrides. Each one falls back to GEMINI_MODEL, then to
# gemini-3.8-flash. Uncomment to pin one side to a different model.
# GEMINI_SOLVE_MODEL=gemini-3.8-flash
# GEMINI_SCENE_MODEL=gemini-3.8-flash
